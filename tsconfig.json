{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "paths": {
      "@core/*": ["./src/core/*"],
      "@adapters/*": ["./src/adapters/*"],
      "@ui/*": ["./src/ui/*"],
      "@third-party/*": ["./src/third_party/*"]
    },
    "strict": true,
    "allowJs": true,
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "types": ["chrome"],
    "noEmit": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*"]
}
