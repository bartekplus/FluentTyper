{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "outDir": "./build",
    "rootDir": "./src",
    "baseUrl": "./src",
    "paths": {
      "@core/*": [
        "core/*"
      ],
      "@adapters/*": [
        "adapters/*"
      ],
      "@ui/*": [
        "ui/*"
      ],
      "@third-party/*": [
        "third_party/*"
      ]
    },
    "strict": true,
    "esModuleInterop": true,
    "allowJs": true, // Allow JavaScript files to be compiled
    "checkJs": false,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "sourceMap": false,
    "typeRoots": [
      "node_modules/@types"
    ]
  },
  "include": [
    "src/**/*"
  ]
}