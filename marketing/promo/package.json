{
  "name": "fluenttyper-promo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "HYPERFRAMES_NO_TELEMETRY=1 hyperframes preview --background --port 3027",
    "lint": "HYPERFRAMES_NO_TELEMETRY=1 hyperframes lint",
    "check": "HYPERFRAMES_NO_TELEMETRY=1 hyperframes check --at 0,1,2.9,3.2,8.9,9.2,13.9,14.2,18,22,26.9,27.2,32.9,33.2,36.9,37.2,39,41.9 --at-transitions",
    "render": "HYPERFRAMES_NO_TELEMETRY=1 hyperframes render --quality delivery --fps 30 --workers 4 --output renders/fluenttyper-promo-1080p.mp4",
    "capture": "cd ../.. && E2E_EXTENSION_PATH=$PWD/build bun marketing/promo/scripts/capture.ts",
    "assemble": "bun scripts/compose.ts",
    "audio": "python3 scripts/audio.py",
    "verify:seeks": "HYPERFRAMES_NO_TELEMETRY=1 node scripts/verify-seeks.mjs",
    "verify:playback": "node scripts/verify-playback.mjs",
    "prepare:video": "bun run capture && bun run audio && bun run assemble"
  },
  "devDependencies": {
    "hyperframes": "0.8.106",
    "gsap": "3.14.2"
  }
}
