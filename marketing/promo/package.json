{
  "name": "fluenttyper-promo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "HYPERFRAMES_NO_TELEMETRY=1 hyperframes preview --background --port 3027",
    "lint": "HYPERFRAMES_NO_TELEMETRY=1 hyperframes lint",
    "check": "HYPERFRAMES_NO_TELEMETRY=1 hyperframes check --at 1,3.5,6.5,9.2,12,14.8,17.5,20.5,23.2,27,32.5,38,42.2,45.5,49,52.5,57 --at-transitions",
    "render": "HYPERFRAMES_NO_TELEMETRY=1 hyperframes render --quality delivery --fps 30 --workers 4 --output renders/fluenttyper-promo-v2-1080p.mp4",
    "capture": "cd ../.. && E2E_EXTENSION_PATH=$PWD/build bun marketing/promo/scripts/capture-v2.ts",
    "assemble": "bun scripts/compose-v2.ts",
    "audio": "python3 scripts/audio-v2.py",
    "verify:seeks": "HYPERFRAMES_NO_TELEMETRY=1 node scripts/verify-seeks.mjs",
    "verify:playback": "node scripts/verify-playback.mjs",
    "prepare:video": "bun run capture && bun run capture:ai && bun run capture:wordpress && bun run audio && bun run assemble",
    "capture:ai": "cd ../.. && PROMO_AI_HEADED=1 E2E_EXTENSION_PATH=$PWD/build bun marketing/promo/scripts/capture-ai.ts",
    "capture:wordpress": "cd ../.. && E2E_EXTENSION_PATH=$PWD/build bun marketing/promo/scripts/capture-wordpress.ts",
    "store-images": "bun scripts/store-images.ts"
  },
  "devDependencies": {
    "hyperframes": "0.8.106",
    "gsap": "3.14.2"
  }
}
