{
  "name": "fluenttyper",
  "version": "2026.27.0",
  "description": "Type less, do more. Get smart autocomplete, spell check, and text expansion to boost your productivity on any website.",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "watch": "bun build.ts --mode=development --watch",
    "build": "bun build.ts --mode=production",
    "check": "bun run lint && bun run format:check && bun run typecheck",
    "check:local-ai:artifact": "bun scripts/check-local-ai-artifact.ts",
    "test:local-ai:real": "bun scripts/local-ai-e2e-real.ts",
    "probe:local-ai": "bun scripts/fetch-local-ai-assets.ts",
    "generate:lexicons": "bun scripts/generate-lexicons.ts",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives .",
    "typecheck": "bun tsc && bun tsc -p tests",
    "test": "bun scripts/run-unit-tests.ts",
    "test:e2e": "bun scripts/run-e2e.ts --suite=smoke",
    "test:e2e:full": "bun scripts/run-e2e.ts --suite=full",
    "test:e2e:dev": "bun scripts/run-e2e.ts --mode=development",
    "check:e2e:coverage": "bun scripts/check-e2e-coverage.ts",
    "update": "bun update --latest --recursive",
    "preversion": "bun run test",
    "version": "bun scripts/update-manifest-version.cjs",
    "postversion": "git push && git push --tags",
    "lint:fix": "oxlint --type-aware --fix --deny-warnings --report-unused-disable-directives .",
    "fix": "bun run lint:fix && bun run format",
    "format": "prettier . --cache --write",
    "format:check": "prettier . --cache --check",
    "bump": "bun pm version",
    "test:e2e:docs": "bun test --timeout=12000 tests/e2e/google-docs.e2e.test.ts",
    "test:e2e:docs:live": "bun scripts/test-google-docs-live.ts",
    "perf:smoke": "bun scripts/performance/run.ts smoke",
    "perf:stress": "bun scripts/performance/run.ts stress",
    "perf:soak": "bun scripts/performance/run.ts soak",
    "perf:ai": "bun scripts/performance/ai.ts",
    "test:e2e:wordpress": "bun scripts/test-wordpress-e2e.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bartekplus/FluentTyper.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bartekplus/FluentTyper/issues"
  },
  "homepage": "https://github.com/bartekplus/FluentTyper#readme",
  "devDependencies": {
    "@lexical/history": "^0.51.0",
    "@lexical/link": "^0.51.0",
    "@lexical/rich-text": "^0.51.0",
    "@types/bun": "^1.4.2",
    "@types/chrome": "^0.3.0",
    "@types/luxon": "^3.7.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@wordpress/block-editor": "18.0.0",
    "@wordpress/block-library": "11.1.0",
    "@wordpress/blocks": "16.1.0",
    "@wordpress/components": "41.0.0",
    "@wordpress/data": "10.56.0",
    "@wordpress/element": "8.8.0",
    "@wordpress/env": "11.16.0",
    "@wordpress/rich-text": "7.56.0",
    "@wp-playground/cli": "3.1.56",
    "ckeditor4": "4.22.1",
    "ckeditor5": "^48.5.2",
    "draft-js": "0.11.7",
    "froala-editor": "5.5.0",
    "jquery": "3.7.1",
    "jsdom": "^30.1.1",
    "lexical": "^0.51.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "prettier": "3.9.9",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-schema-basic": "1.2.5",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.6",
    "puppeteer": "25.12.0",
    "quill": "^2.0.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-dom18": "npm:react-dom@18.3.1",
    "react18": "npm:react@18.3.1",
    "slate": "^0.126.2",
    "slate-dom": "^0.126.0",
    "slate-history": "^0.113.1",
    "slate-react": "^0.127.1",
    "summernote": "0.9.1",
    "tinymce": "8.9.2",
    "trix": "2.1.19",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "buffer": "^6.0.3",
    "csv-parse": "^7.0.2",
    "csv-stringify": "^6.8.3",
    "luxon": "^3.7.2"
  }
}
