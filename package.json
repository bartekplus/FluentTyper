{
  "name": "fluenttyper",
  "version": "2026.35.0",
  "description": "Type less, do more. Get smart autocomplete, spell check, and text expansion to boost your productivity on any website.",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "watch": "bun build.ts --mode=development --watch",
    "build": "bun build.ts --mode=production",
    "check": "bun run lint && bun run format:check && bun run typecheck",
    "compile:grammar": "bun scripts/compile-grammar-rules.ts",
    "postinstall": "bun scripts/compile-grammar-rules.ts",
    "bench:review": "bun scripts/bench-review.ts",
    "check:local-ai:artifact": "bun scripts/check-local-ai-artifact.ts",
    "test:local-ai:real": "bun scripts/local-ai-e2e-real.ts",
    "probe:local-ai": "bun scripts/fetch-local-ai-assets.ts",
    "generate:lexicons": "bun scripts/generate-lexicons.ts",
    "lint": "bun run compile:grammar && oxlint --type-aware --deny-warnings --report-unused-disable-directives . src/core/domain/grammar/engine/*.generated.ts src/core/domain/grammar/review/rules/*.ts src/core/domain/grammar/review/*/phrases.generated.ts",
    "typecheck": "bun run compile:grammar && bun scripts/require-bun-check.ts && bun --check && bun --check --tsconfig-override=tests/tsconfig.json",
    "test": "bun run compile:grammar && bun scripts/run-unit-tests.ts",
    "test:e2e": "bun scripts/run-e2e.ts --suite=smoke",
    "test:e2e:full": "bun scripts/run-e2e.ts --suite=full",
    "test:e2e:dev": "bun scripts/run-e2e.ts --mode=development",
    "check:e2e:coverage": "bun scripts/check-e2e-coverage.ts",
    "update": "bun update --latest --recursive",
    "preversion": "bun run test",
    "version": "bun scripts/update-manifest-version.cjs",
    "postversion": "git push && git push --tags",
    "lint:fix": "bun run compile:grammar && oxlint --type-aware --fix --deny-warnings --report-unused-disable-directives .",
    "fix": "bun run lint:fix && bun run format",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "bump": "bun pm version",
    "test:e2e:docs": "bun test --timeout=12000 tests/e2e/google-docs.e2e.test.ts",
    "test:e2e:docs:live": "bun scripts/test-google-docs-live.ts",
    "perf:smoke": "bun scripts/performance/run.ts smoke",
    "perf:stress": "bun scripts/performance/run.ts stress",
    "perf:soak": "bun scripts/performance/run.ts soak",
    "perf:ai": "bun scripts/performance/ai.ts",
    "test:e2e:wordpress": "bun scripts/test-wordpress-e2e.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bartekplus/FluentTyper.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bartekplus/FluentTyper/issues"
  },
  "homepage": "https://github.com/bartekplus/FluentTyper#readme",
  "devDependencies": {
    "@lexical/history": "^0.53.0",
    "@lexical/link": "^0.53.0",
    "@lexical/rich-text": "^0.53.0",
    "@tiptap/core": "3.32.1",
    "@tiptap/pm": "3.32.1",
    "@tiptap/starter-kit": "3.32.1",
    "@types/bun": "^1.4.4",
    "@types/chrome": "^0.3.7",
    "@types/luxon": "^3.7.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wordpress/block-editor": "19.0.0",
    "@wordpress/block-library": "12.0.0",
    "@wordpress/blocks": "17.0.0",
    "@wordpress/components": "43.0.0",
    "@wordpress/data": "11.0.0",
    "@wordpress/element": "10.0.0",
    "@wordpress/env": "12.0.0",
    "@wordpress/rich-text": "8.0.0",
    "@wp-playground/cli": "3.1.61",
    "ckeditor4": "4.22.1",
    "ckeditor5": "^49.0.1",
    "codemirror": "5.65.20",
    "draft-js": "0.11.7",
    "froala-editor": "5.5.0",
    "jquery": "3.7.1",
    "jsdom": "^30.1.3",
    "lexical": "^0.53.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-schema-basic": "1.2.5",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.8",
    "puppeteer": "25.16.0",
    "quill": "^2.0.3",
    "quill1": "npm:quill@1.3.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-dom18": "npm:react-dom@18.3.1",
    "react18": "npm:react@18.3.1",
    "roosterjs": "9.61.0",
    "slate": "^0.147.4",
    "slate-dom": "^0.147.3",
    "slate-history": "^0.144.0",
    "slate-react": "^0.147.5",
    "summernote": "0.9.1",
    "tinymce": "8.10.1",
    "trix": "2.1.19",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "buffer": "^6.0.3",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "emojilib": "4.0.3",
    "luxon": "^3.7.2"
  }
}
