{
  "name": "fluenttyper",
  "version": "2026.1.0",
  "description": "Type less, do more. Get smart autocomplete, spell check, and text expansion to boost your productivity on any website.",
  "type": "module",
  "scripts": {
    "watch": "webpack --mode=development --config webpack/webpack.js --watch",
    "build": "webpack --mode=production --config webpack/webpack.js",
    "check": "eslint . && prettier '**/*.{html,css}' --check",
    "lint": "eslint --fix . && prettier '**/*.{html,css,js,ts}' --write",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config=jest.config.ts",
    "test:e2e": "PLATFORM=chrome $npm_execpath run build && jest --config=jest-e2e.config.ts",
    "update": "ncu -u && npm update",
    "preversion": "npm test",
    "version": "node scripts/update-manifest-version.cjs",
    "postversion": "git push && git push --tags"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bartekplus/FluentTyper.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bartekplus/FluentTyper/issues"
  },
  "homepage": "https://github.com/bartekplus/FluentTyper#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.1.37",
    "@types/dom-navigation": "^1.0.7",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.1",
    "copy-webpack-plugin": "^13.0.1",
    "eslint": "^10.0.1",
    "glob": "^13.0.6",
    "globals": "^17.3.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-puppeteer": "^11.0.0",
    "npm-check-updates": "latest",
    "prettier": "^3.8.1",
    "puppeteer": "^24.37.5",
    "rimraf": "^6.1.3",
    "terser-webpack-plugin": "^5.3.16",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "webpack": "^5.105.2",
    "webpack-cli": "^6.0.1",
    "webpack-merge": "^6.0.1"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.6.0",
    "luxon": "^3.7.2"
  }
}
