  "devDependencies": {
    "@types/chrome": "0.0.326",
    "@types/jest": "29.5.14",
    "copy-webpack-plugin": "^13.0.0",
    "glob": "11.0.2",
    "jest": "29.7.0",
    "jest-environment-jsdom": "^30.0.0",
    "npm-check-updates": "latest",
    "prettier": "3.5.3",
    "rimraf": "6.0.1",
    "ts-jest": "29.3.4",
    "ts-loader": "9.5.2",
    "typescript": "5.8.3",
